# 이 파일을 같은 폴더에 복사해서 이름을 secret.properties 로 바꾸고 값을 채운다.
# secret.properties 는 .gitignore 에 들어 있어서 GitHub 에 올라가지 않는다.
# 이 example 파일에는 실제 비밀번호나 키를 절대 적지 않는다.

# DB (각자 PC의 Oracle 계정)
db.url=jdbc:log4jdbc:oracle:thin:@localhost:1521/XEPDB1
db.username=spring
db.password=PASSWORD

# API 키 (필요한 파트가 생기면 담당자가 이름을 정해서 추가한다)
# kakao.rest.key=
# gemini.api.key=
