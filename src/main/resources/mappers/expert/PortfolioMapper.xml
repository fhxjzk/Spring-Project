<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- namespace는 Mapper 인터페이스의 전체 이름과 같아야 한다 -->
<mapper namespace="com.project.app.expert.mapper.PortfolioMapper">

	<select id="getPortfolio" parameterType="Long" resultType="ExpertPortfolioDto">
	     select p.*,m.name from tbl_portfolio p
	     	inner join tbl_member m on p.expert_seq = m.member_seq
	     		where p.portfolio_seq = #{portfolioSeq}
	</select>

	<select id="getPortfolioImages" parameterType="Long" resultType="PortfolioImageDto">
		select * from tbl_portfolio_image
			where portfolio_seq = #{portfolioSeq}
				order by slot
	</select>
